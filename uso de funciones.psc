Algoritmo UsoFunciones
	definir n,seno, coseno,tangente, raizcuadrada,in,log10 como real
	Escribir "ingrse el numero"
	Leer n
	seno=sen(n)
	coseno=cos(n)
	tangente=tan(n)
	raizcudrada=Raiz(n)
	In=Ln(n)
	log10=ln(n)/ln(10)
	Escribir "numero:",n
	Escribir "seno:",seno
	Escribir "coseno:", coseno
	Escribir "tangente", tangente
	Escribir "raizcuadrada:",raizcudrada
	Escribir "in:",in
	Escribir "log10",log10
FinAlgoritmo
